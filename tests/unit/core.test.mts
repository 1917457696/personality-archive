import test from 'node:test';
import assert from 'node:assert/strict';
import { validateReport,buildPrompt,requestReport,preflightReport } from '../../src/service/reportService.ts';
import { exportBackup,conflicts } from '../../src/service/backupService.ts';
import { markReportsStale } from '../../src/service/archiveService.ts';
import { extractPages } from '../../src/service/pdfText.ts';
const source={id:'s1',profileId:'p1',kind:'text',title:'对话',text:'我希望先把这件事说清楚，再决定要不要继续。',createdAt:1,updatedAt:1};
const raw={summary:'暂时的观察。',caveat:'材料有限。',dimensions:{mbti:[{observation:'表达偏审慎。',inference:'我倾向于认为对方可能重视计划。',alternative:'也可能只是这件事比较重要。',evidence:[{quote:'先把这件事说清楚',sourceId:'s1'}]}],enneagram:[],bigFive:[]}};
test('report drops a finding with no exact validated evidence and strips text page numbers',()=>{const data={...raw,dimensions:{...raw.dimensions,mbti:[{...raw.dimensions.mbti[0],evidence:[{quote:'这句原文不存在',sourceId:'s1'}]},{...raw.dimensions.mbti[0],evidence:[{quote:'先把这件事说清楚',sourceId:'s1',page:1}]}]}};const r=validateReport(data,'p1',[source]);assert.equal(r.dimensions.mbti.length,1);assert.equal(r.dimensions.mbti[0].evidence[0].page,undefined)});
test('PDF citation must match the cited page exactly',()=>{const pdf={...source,id:'pdf1',kind:'pdf',text:'甲页内容\n\n乙页内容',pages:[{page:1,text:'甲页内容'},{page:2,text:'乙页内容'}]};const data={...raw,dimensions:{...raw.dimensions,mbti:[{...raw.dimensions.mbti[0],evidence:[{quote:'乙页内容',sourceId:'pdf1',page:1},{quote:'乙页内容',sourceId:'pdf1',page:2}]}]}};const r=validateReport(data,'p1',[pdf]);assert.equal(r.dimensions.mbti[0].evidence.length,1);assert.equal(r.dimensions.mbti[0].evidence[0].page,2)});
test('report rejects missing dimensions and source selection excludes unchosen content from prompt',()=>{assert.throws(()=>validateReport({summary:'x',caveat:'y',dimensions:{mbti:[]}},'p1',[source]));const extra={...source,id:'s2',text:'不应包含的私人文字'};const prompt=buildPrompt([source]);assert.match(prompt,/我希望先把这件事说清楚/);assert.doesNotMatch(prompt,/不应包含的私人文字/);assert.doesNotMatch(buildPrompt([extra]),/sourceId=s1/)});
test('backup excludes runtime keys and detects ID conflicts',()=>{const data={profiles:[{id:'p1',name:'样本',createdAt:1,updatedAt:1}],sources:[source],reports:[]};const backup=exportBackup(data);return backup.text().then(text=>{assert.match(text,/样本/);assert.doesNotMatch(text,/sk-[A-Za-z0-9_-]{8,}/);assert.deepEqual(conflicts(data,{profiles:[{...data.profiles[0],name:'备份名'}],sources:[],reports:[]}).map(x=>x.id),['p1'])})});
test('material changes mark only matching profile reports stale',()=>{const rows=[{id:'r1',profileId:'p1',stale:false},{id:'r2',profileId:'p2',stale:false}];const out=markReportsStale(rows as any,'p1');assert.equal(out[0].stale,true);assert.equal(out[1].stale,false)});
test('PDF text extraction preserves page numbers and returns no pages for scanned files',async()=>{const doc={numPages:2,async getPage(page:number){return{async getTextContent(){return{items:page===1?[{str:'第一页'},{str:'正文'}]:[]}}}}};assert.deepEqual(await extractPages(doc),[{page:1,text:'第一页 正文'}]);const empty={numPages:1,async getPage(){return{async getTextContent(){return{items:[]}}}}};assert.deepEqual(await extractPages(empty),[])});
test('report preflight blocks oversized material before a provider request',async()=>{const oversized={...source,text:'字'.repeat(42000)};assert.equal(preflightReport([oversized]).ok,false);const original=globalThis.fetch;let called=false;globalThis.fetch=async()=>{called=true;throw new Error('should not call')};try{await assert.rejects(requestReport('openai','gpt-4o-mini','sk-never-log',[oversized]),/不会自动截断/);assert.equal(called,false)}finally{globalThis.fetch=original}});
test('mocked provider failures never expose the supplied key',async()=>{const original=globalThis.fetch;const secret='sk-never-log-this-value';try{globalThis.fetch=async()=>{throw new Error('network error: '+secret)};await assert.rejects(requestReport('openai','gpt-6-luna',secret,[source]),e=>!e.message.includes(secret)&&e.message.includes('连接失败'));for(const provider of ['openai','kimi','claude','deepseek'] as const){globalThis.fetch=async()=>new Response(JSON.stringify({error:{message:secret}}),{status:401});await assert.rejects(requestReport(provider,'test-model',secret,[source]),e=>!e.message.includes(secret)&&e.message.includes('拒绝了请求'))}}finally{globalThis.fetch=original}});
test('repository cascades profile deletion and honors merge replacement choice',async()=>{await import('fake-indexeddb/auto');const {repository}=await import('../../src/repo/archiveRepo.ts');const profile={id:'cascade-profile-test',name:'本人',createdAt:1,updatedAt:1};await repository.saveProfile(profile);await repository.saveSource({...source,id:'cascade-source-test',profileId:profile.id});await repository.saveReport({id:'cascade-report-test',profileId:profile.id,createdAt:1,sourceIds:['cascade-source-test'],dimensions:{mbti:[],enneagram:[],bigFive:[]},summary:'s',caveat:'c',stale:false});await repository.deleteProfile(profile.id);let all=await repository.all();assert.equal(all.profiles.some(x=>x.id===profile.id),false);assert.equal(all.sources.some(x=>x.id==='cascade-source-test'),false);assert.equal(all.reports.some(x=>x.id==='cascade-report-test'),false);await repository.saveProfile(profile);await repository.merge({profiles:[{...profile,name:'备份版本'}],sources:[],reports:[]},{[profile.id]:'replace'});all=await repository.all();assert.equal(all.profiles.find(x=>x.id===profile.id)?.name,'备份版本')});
